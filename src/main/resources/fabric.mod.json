{
	"schemaVersion": 1,
	"id": "soundmuter",
	"version": "${version}",
	"name": "Sound Muter",
	"description": "Mute or turn down individual sounds. Client-side, works on any server.",
	"authors": ["SpeedyCoder1192"],
	"license": "MIT",
	"icon": "assets/soundmuter/icon.png",
	"contact": {
		"sources": "https://github.com/SpeedyCoder1192/sound-muter",
		"issues": "https://github.com/SpeedyCoder1192/sound-muter/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.soundmuter.platform.fabric.SoundMuterFabric"
		],
		"modmenu": [
			"dev.soundmuter.platform.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"soundmuter.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
